<Window x:Class="EditorDeTextoSimples.DialogoLocalizar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Localizar e substituir — Lume" Width="660" Height="430"
        MinWidth="620" MinHeight="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}" Foreground="{DynamicResource DialogTextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="DialogTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DialogInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource DialogAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource DialogInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}" /><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DialogHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource DialogAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource DialogAccentBrush}" Margin="0,0,12,0">
                <TextBlock Text="⌕" FontSize="25" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Localizar e substituir" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource DialogTextBrush}" />
                <TextBlock Text="Encontra e atualiza texto neste documento." FontSize="12" Foreground="{DynamicResource DialogMutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="52" /></Grid.RowDefinitions>
            <TextBlock Text="Localizar" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource DialogTextBrush}" />
            <TextBox x:Name="FindBox" Grid.Column="1" Style="{StaticResource DialogTextBox}" />
            <TextBlock Grid.Row="1" Text="Substituir por" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource DialogTextBrush}" />
            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogTextBox}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="112,10,0,0">
            <CheckBox x:Name="MatchCaseBox" Content="Distinguir maiúsculas" Foreground="{DynamicResource DialogMutedBrush}" Margin="0,0,24,0" VerticalAlignment="Center" />
            <CheckBox x:Name="WholeWordBox" Content="Palavra inteira" Foreground="{DynamicResource DialogMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" Margin="112,14,0,0" Padding="11,7" Background="{DynamicResource DialogHoverBrush}" CornerRadius="9">
            <TextBlock x:Name="FeedbackText" Text="Escreve o texto que pretendes localizar." FontSize="11" Foreground="{DynamicResource DialogMutedBrush}" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fechar" IsCancel="True" MinWidth="82" Style="{StaticResource DialogButton}" Click="Close_Click" Margin="0,0,8,0" />
            <Button Content="Substituir tudo" MinWidth="116" Style="{StaticResource DialogButton}" Click="ReplaceAll_Click" Margin="0,0,8,0" />
            <Button Content="Substituir" MinWidth="100" Style="{StaticResource DialogButton}" Click="Replace_Click" Margin="0,0,8,0" />
            <Button x:Name="FindNextButton" Content="Localizar próximo" MinWidth="142" Style="{StaticResource PrimaryDialogButton}" IsDefault="True" Click="Find_Click" />
        </StackPanel>
    </Grid>
</Window>
