<Window x:Class="EditorDeTextoSimples.DialogoLocalizar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Localizar e substituir — Lume" Width="570" Height="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F7F6F3" FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="26,20,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Localizar e substituir" FontSize="19" FontWeight="SemiBold" Foreground="#252936" />
        <TextBlock Grid.Row="1" Text="Encontra texto neste documento e substitui uma ou todas as ocorrências." Foreground="#777C88" Margin="0,5,0,18" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <TextBlock Text="Localizar" VerticalAlignment="Center" Foreground="#414653" />
            <TextBox x:Name="FindBox" Grid.Column="1" Height="30" Padding="8,4" VerticalContentAlignment="Center" BorderBrush="#DAD9D4" Background="White" />
            <TextBlock Grid.Row="1" Text="Substituir" VerticalAlignment="Center" Foreground="#414653" />
            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Height="30" Padding="8,4" VerticalContentAlignment="Center" BorderBrush="#DAD9D4" Background="White" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="86,10,0,0">
            <CheckBox x:Name="MatchCaseBox" Content="Distinguir maiúsculas" Foreground="#777C88" Margin="0,0,23,0" />
            <CheckBox x:Name="WholeWordBox" Content="Palavra inteira" Foreground="#777C88" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fechar" IsCancel="True" MinWidth="74" Padding="12,7" Margin="0,0,8,0" Click="Close_Click" />
            <Button Content="Substituir tudo" MinWidth="110" Padding="12,7" Margin="0,0,8,0" Click="ReplaceAll_Click" />
            <Button Content="Substituir" MinWidth="90" Padding="12,7" Margin="0,0,8,0" Click="Replace_Click" />
            <Button x:Name="FindNextButton" Content="Localizar próximo" MinWidth="128" Padding="12,7" Background="#EB6B50" Foreground="White" BorderBrush="#EB6B50" IsDefault="True" Click="Find_Click" />
        </StackPanel>
    </Grid>
</Window>
