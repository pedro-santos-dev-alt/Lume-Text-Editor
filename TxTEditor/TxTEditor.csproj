<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>  <!-- Makes it a GUI app (not console) -->
    <AssemblyName>Lume</AssemblyName>
    <Product>Lume</Product>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <ApplicationIcon>Assets\Lume.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>  <!-- Must include "-windows" -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
</Project>
