<Window x:Class="EditorDeTextoSimples.FormularioEditorDeTexto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EditorDeTextoSimples"
        Title="Lume — O teu espaço para escrever"
        Width="1440" Height="900" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{DynamicResource AppCanvasBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppCanvasBrush" Color="#F3F5FB" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#EEF1F9" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#34394B" />
        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#848BA0" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E2E7F5" />
        <SolidColorBrush x:Key="SidebarFooterBrush" Color="#E9ECF5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6257E8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEEAFE" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5247D2" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F8FC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E5EF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#24293A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#697187" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9299AA" />
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5267E8" Offset="0" /><GradientStop Color="#8765E8" Offset="1" /></LinearGradientBrush>
        <SolidColorBrush x:Key="HeroSoftBrush" Color="#52FFFFFF" />

        <Style x:Key="TopMenuButton" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Tab" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,3">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Tab}" VerticalOffset="7"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="7" MinWidth="226" Opacity="0.97">
                                    <Border.Effect><DropShadowEffect Color="#242936" BlurRadius="22" ShadowDepth="8" Opacity="0.16" /></Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuCommand" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="1,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="22,0,2,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{DynamicResource BorderBrush}" Height="1" /></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SidebarAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{Binding RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                                  Width="16" Height="16" Cursor="Hand"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" SnapsToDevicePixels="True">
                                                    <Path x:Name="Chevron" Data="M 1.5 1.5 L 5 5 L 1.5 8.5"
                                                          Stroke="{DynamicResource SidebarMutedBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource SidebarTextBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="Children" Margin="14,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Children" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="ItemSurface" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTree" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceTreeItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="0,2" />
            <Style.Resources>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource WorkspaceTreeItem}" />
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,23,18,5" Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="L" FontFamily="Georgia" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="lume" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" LineHeight="23" />
                    <TextBlock Text="ESPAÇO PARA ESCREVER" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SidebarMutedBrush}" Margin="1,3,0,0" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,17,16,20">
                    <Button Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,0,22" Click="NewDocument_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="18" Margin="0,-2,8,0" /><TextBlock Text="Novo documento" FontSize="13" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Height="38" Margin="0,-12,0,18" Click="OpenWebStudio_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌘" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="Web Studio" FontSize="12" FontWeight="SemiBold" /></StackPanel>
                    </Button>

                    <TextBlock Text="DOCUMENTO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedBrush}" Margin="10,0,0,7" />
                    <Button Style="{StaticResource SidebarAction}" Click="OpenFile_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▱" FontSize="17" Foreground="{DynamicResource SidebarMutedBrush}" Width="25" /><TextBlock Text="Abrir ficheiro" /></StackPanel>
                    </Button>
                    <Button x:Name="FindSidebarButton" Style="{StaticResource SidebarAction}" Click="Find_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource SidebarMutedBrush}" Width="25" /><TextBlock Text="Localizar texto" /></StackPanel>
                    </Button>

                    <StackPanel x:Name="EditorSidebarActions">
                        <TextBlock Text="FORMATAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedBrush}" Margin="10,22,0,7" />
                        <Button Style="{StaticResource SidebarAction}" Click="Bold_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="B" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Grid.Column="1" Text="Negrito" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Ctrl+B" FontSize="10" Foreground="{DynamicResource SidebarMutedBrush}" FontFamily="Consolas" /></Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarAction}" Click="Italic_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" Foreground="{DynamicResource AccentBrush}" /><TextBlock Grid.Column="1" Text="Itálico" FontStyle="Italic" /><TextBlock Grid.Column="2" Text="Ctrl+I" FontSize="10" Foreground="{DynamicResource SidebarMutedBrush}" FontFamily="Consolas" /></Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarAction}" Click="Underline_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="U" TextDecorations="Underline" Foreground="{DynamicResource AccentBrush}" /><TextBlock Grid.Column="1" Text="Sublinhado" TextDecorations="Underline" /><TextBlock Grid.Column="2" Text="Ctrl+U" FontSize="10" Foreground="{DynamicResource SidebarMutedBrush}" FontFamily="Consolas" /></Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <Grid Margin="10,0,0,9">
                            <TextBlock Text="ESPAÇO DE TRABALHO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedBrush}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="7,3" HorizontalAlignment="Right">
                                <TextBlock Text="PASTA" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Height="38" Margin="2,0,2,9" Click="OpenWorkspace_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M 1.5,2.5 C 1.5,1.95 1.95,1.5 2.5,1.5 L 5.5,1.5 C 5.8,1.5 6.1,1.7 6.3,1.9 L 7.3,3.1 C 7.5,3.3 7.8,3.5 8.2,3.5 L 12.5,3.5 C 13.05,3.5 13.5,3.95 13.5,4.5 L 13.5,11.5 C 13.5,12.05 13.05,12.5 12.5,12.5 L 2.5,12.5 C 1.95,12.5 1.5,12.05 1.5,11.5 Z"
                                      Fill="White" Width="14" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir pasta..." FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,9" Margin="2,0,2,5">
                            <StackPanel>
                                <TextBlock Text="PASTA ATUAL" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock x:Name="WorkspaceFolderName" Text="Nenhuma pasta selecionada" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                            </StackPanel>
                        </Border>
                        <TreeView x:Name="WorkspaceTree" Style="{StaticResource WorkspaceTree}" MaxHeight="320" SelectedItemChanged="WorkspaceTree_SelectedItemChanged">
                            <TreeView.Resources>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource WorkspaceTreeItem}" />
                            </TreeView.Resources>
                        </TreeView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SidebarFooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="19,14,18,17">
                <StackPanel>
                    <TextBlock Text="ATALHO RÁPIDO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,0,0,9" />
                    <Button Style="{StaticResource SidebarAction}" Height="32" Padding="0" Click="SaveFile_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Ctrl + S" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,0,14,0" /><TextBlock x:Name="FooterShortcut" Text="Guardar documento" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarAction}" Height="32" Padding="0" Click="ThemeButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◐" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" /><TextBlock x:Name="ThemeButtonLabel" Text="Tema escuro" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main workspace -->
        <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="78" />
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="18,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Stretch">
                <MenuItem Header="Ficheiro" Style="{StaticResource TopMenuButton}" ItemContainerStyle="{StaticResource MenuCommand}">
                    <MenuItem Header="Novo documento" InputGestureText="Ctrl+N" Click="NewDocument_Click" />
                    <MenuItem Header="Abrir…" InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                    <Separator />
                    <MenuItem Header="Guardar" InputGestureText="Ctrl+S" Click="SaveFile_Click" />
                    <MenuItem Header="Guardar como…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                    <Separator />
                    <MenuItem Header="Imprimir…" InputGestureText="Ctrl+P" Click="Print_Click" />
                    <Separator />
                    <MenuItem Header="Sair" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="Editar" Style="{StaticResource TopMenuButton}" ItemContainerStyle="{StaticResource MenuCommand}">
                    <MenuItem Header="Anular" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                    <MenuItem Header="Refazer" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                    <Separator />
                    <MenuItem Header="Cortar" InputGestureText="Ctrl+X" Click="Cut_Click" />
                    <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="Copy_Click" />
                    <MenuItem Header="Colar" InputGestureText="Ctrl+V" Click="Paste_Click" />
                    <MenuItem Header="Selecionar tudo" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                    <Separator />
                    <MenuItem Header="Localizar e substituir…" InputGestureText="Ctrl+F" Click="Find_Click" />
                </MenuItem>
                <MenuItem Header="Formatar" Style="{StaticResource TopMenuButton}" ItemContainerStyle="{StaticResource MenuCommand}">
                    <MenuItem Header="Negrito" InputGestureText="Ctrl+B" Click="Bold_Click" />
                    <MenuItem Header="Itálico" InputGestureText="Ctrl+I" Click="Italic_Click" />
                    <MenuItem Header="Sublinhado" InputGestureText="Ctrl+U" Click="Underline_Click" />
                </MenuItem>
                <MenuItem Header="Ver" Style="{StaticResource TopMenuButton}" ItemContainerStyle="{StaticResource MenuCommand}">
                    <MenuItem Header="Aumentar texto" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                    <MenuItem Header="Diminuir texto" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                    <MenuItem Header="Tamanho original" InputGestureText="Ctrl+0" Click="ZoomReset_Click" />
                    <Separator />
                    <MenuItem Header="Alternar modo de foco" InputGestureText="F11" Click="ToggleFocus_Click" />
                    <MenuItem Header="Alternar tema claro/escuro" InputGestureText="Ctrl+Shift+T" Click="ThemeButton_Click" />
                    <Separator />
                    <MenuItem Header="Verificar atualizações…" Click="CheckForUpdates_Click" />
                </MenuItem>
            </Menu>

            <Grid x:Name="DocumentHeader" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Margin="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="32,0,0,0">
                    <TextBlock Text="ESPAÇO DE TRABALHO  /  DOCUMENTO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="DocumentTitle" Text="Documento sem título" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Border x:Name="SaveBadge" Grid.Column="1" Background="#EEF6EF" CornerRadius="12" Padding="11,6" Margin="0,0,30,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SaveState" Text="●  Guardado" FontSize="10" FontWeight="SemiBold" Foreground="#508260" />
                </Border>
                <Border Grid.ColumnSpan="2" Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" />
            </Grid>

            <Border x:Name="EditorToolbar" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,9" Opacity="0.97">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Padding="13,7" Click="NewDocument_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="15" Margin="0,-1,7,0" /><TextBlock Text="Novo" /></StackPanel></Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OpenFile_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Abrir" /></StackPanel></Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="SaveFile_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Guardar" /></StackPanel></Button>
                    <Border Width="1" Height="23" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                    <Button Style="{StaticResource ToolbarButton}" Padding="10,6" Click="Undo_Click" ToolTip="Anular (Ctrl+Z)"><TextBlock Text="↶" FontSize="18" /></Button>
                    <Button Style="{StaticResource ToolbarButton}" Padding="10,6" Click="Redo_Click" ToolTip="Refazer (Ctrl+Y)"><TextBlock Text="↷" FontSize="18" /></Button>
                    <Border Width="1" Height="23" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                    <Button Style="{StaticResource ToolbarButton}" Padding="12,7" Click="Bold_Click"><TextBlock Text="B" FontWeight="Bold" /></Button>
                    <Button Style="{StaticResource ToolbarButton}" Padding="12,7" Click="Italic_Click"><TextBlock Text="I" FontStyle="Italic" /></Button>
                    <Button Style="{StaticResource ToolbarButton}" Padding="12,7" Click="Underline_Click"><TextBlock Text="U" TextDecorations="Underline" /></Button>
                    <Border Width="1" Height="23" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                    <Button Style="{StaticResource ToolbarButton}" Click="Find_Click"><TextBlock Text="Localizar" /></Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Print_Click"><TextBlock Text="Imprimir" /></Button>
                    <Border Width="1" Height="23" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                    <Button Style="{StaticResource ToolbarButton}" Padding="10,6" Click="ZoomOut_Click"><TextBlock Text="−" FontSize="17" /></Button>
                    <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource ToolbarButton}" Padding="10,6" Click="ZoomIn_Click"><TextBlock Text="＋" FontSize="15" /></Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ToggleFocus_Click" ToolTip="Alternar modo de foco"><TextBlock x:Name="FocusButtonLabel" Text="Foco" /></Button>
                </StackPanel>
            </Border>

            <Grid x:Name="EditorArea" Grid.Row="3" Background="{DynamicResource CanvasBrush}">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="54,34,54,34" Padding="24,48,48,48" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <local:LineNumberGutter x:Name="LineNumbers" Grid.Column="0" Editor="{Binding ElementName=Editor}" />
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,2" />
                        <RichTextBox x:Name="Editor" Grid.Column="2" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontFamily="Segoe UI" FontSize="14" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="Editor_SelectionChanged" TextChanged="Editor_TextChanged"
                                     SelectionBrush="{DynamicResource AccentBrush}" SelectionTextBrush="White" SelectionOpacity="0.88" IsInactiveSelectionHighlightEnabled="True"
                                     SpellCheck.IsEnabled="True" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="StatusBar" Grid.Row="4" Background="{DynamicResource SurfaceBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0">
                    <TextBlock x:Name="CursorState" Text="Linha 1, coluna 1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" />
                    <TextBlock x:Name="WordState" Text="0 palavras" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" />
                    <TextBlock x:Name="CharacterState" Text="0 caracteres" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="LUME  ·  TXT / RTF" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,26,0" />
                <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Top" />
            </Grid>

            <Grid x:Name="HomeView" Grid.Row="1" Grid.RowSpan="4" Background="{DynamicResource CanvasBrush}" Panel.ZIndex="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1040" Margin="54,42,54,38" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,27">
                            <TextBlock Text="O TEU ESPAÇO DE ESCRITA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Bom ter-te aqui." FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,0" />
                            <TextBlock Text="Um lugar tranquilo para organizar ideias e dar forma às palavras." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="1,5,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="22" Background="{DynamicResource HeroBrush}" Padding="34" Margin="0,0,0,27">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,2,26,2">
                                    <Border Background="{DynamicResource HeroSoftBrush}" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,17">
                                        <TextBlock Text="✦  UM NOVO COMEÇO" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="Uma página em branco.&#10;Mil possibilidades." FontSize="27" FontWeight="SemiBold" Foreground="White" LineHeight="35" />
                                    <TextBlock Text="Começa com uma ideia e deixa as palavras encontrar o seu ritmo." TextWrapping="Wrap" FontSize="13" Foreground="#E6E9FF" Margin="0,12,0,21" MaxWidth="430" />
                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,10" Click="NewDocument_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16" Margin="0,-1,8,0" /><TextBlock Text="Criar documento" /></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="218" Height="190">
                                    <Ellipse Width="164" Height="164" Fill="#42FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"><Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect></Ellipse>
                                    <Border Width="151" Height="174" Background="#FBFCFF" CornerRadius="11" Padding="18,17" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><RotateTransform Angle="-4" /></Border.RenderTransform>
                                        <StackPanel>
                                            <Border Width="25" Height="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,2,0,16" />
                                            <TextBlock Text="As tuas ideias&#10;merecem espaço." FontSize="15" FontWeight="SemiBold" Foreground="#303442" LineHeight="21" />
                                            <Border Height="1" Background="#E3E7F2" Margin="0,13,0,10" />
                                            <Border Height="4" Background="#E5E8F2" CornerRadius="2" Margin="0,0,7,7" />
                                            <Border Height="4" Background="#E5E8F2" CornerRadius="2" Margin="0,0,22,7" />
                                            <Border Height="4" Background="#E5E8F2" CornerRadius="2" Margin="0,0,32,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Width="48" Height="48" Background="{DynamicResource AccentBrush}" CornerRadius="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,4">
                                        <TextBlock Text="L" FontFamily="Georgia" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="COMEÇA EM SEGUNDOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,9,0" HorizontalContentAlignment="Stretch" Cursor="Hand" Click="NewDocument_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}" CornerRadius="13" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Documento em branco" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Uma folha limpa para começar." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="9,0,0,0" HorizontalContentAlignment="Stretch" Cursor="Hand" Click="OpenFile_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="42" Height="42" Background="#E9ECFA" CornerRadius="13" VerticalAlignment="Center"><TextBlock Text="↗" FontSize="20" Foreground="#596FD6" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Abrir um ficheiro" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Continua um documento guardado." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,21,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="DICA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,13,0" VerticalAlignment="Center" /><TextBlock Text="Usa Ctrl + N para abrir um documento novo a qualquer momento." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
